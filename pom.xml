<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>pe.upeu</groupId>
    <artifactId>wendysfood-nullpointer-pos</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Wendy's Food - NullPointer POS</name>
    <description>Proyecto multimódulo de microservicios para la gestión de pedidos, mesas y cocina.</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <jjwt.version>0.12.6</jjwt.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>infrastructure/eureka-server</module>
        <module>infrastructure/config-server</module>
        <module>microservice/authentication-service</module>
        <module>microservice/products-service</module>
        <module>microservice/orders-service</module>
        <module>microservice/kitchen-service</module>
        <module>microservice/cashier-service</module>
        <module>microservice/inventory-service</module>
        <module>infrastructure/api-gateway</module>
    </modules>
</project>
