# Copia este archivo como .env para usar estos valores locales.
# Cambia SECRETO_JWT antes de cualquier despliegue fuera de tu PC.
USUARIO_BASE_DATOS=nullpointer
CLAVE_BASE_DATOS=nullpointer_local_2026
MAX_CONEXIONES_BD=10
MIN_CONEXIONES_BD=2
USUARIO_RABBITMQ=nullpointer
CLAVE_RABBITMQ=nullpointer_rabbit_local_2026
SECRETO_JWT=NullPointerPOS-Local-Secret-For-Demo-Only-2026!ChangeBeforeProduction
VIGENCIA_JWT_MINUTOS=480
ORIGENES_CORS_PERMITIDOS=*

# Integracion de WhatsApp PDF via Green-API (recomendado para dev y Render)
# Obten estos 3 datos en https://console.green-api.com (Developer Plan gratuito)
GREENAPI_MEDIA_URL=https://media.green-api.com
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# Consulta automatica de DNI (RENIEC) y RUC (SUNAT)
# Proveedor recomendado por defecto: APISPERU (token gratis en https://apisperu.com)
# Tambien soporta DECOLECTA (antes apis.net.pe, token en https://decolecta.com)
CONSULTA_DOC_PROVEEDOR=APISPERU
CONSULTA_DOC_TOKEN=
CONSULTA_DOC_URL=

# Opcional / legacy: URL completa de sendFileByUpload si se prefiere formato unico
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
